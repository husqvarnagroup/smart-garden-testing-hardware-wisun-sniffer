# Enable MPU
CONFIG_ARM_MPU=y

# Enable hardware stack protection
CONFIG_HW_STACK_PROTECTION=y

# Enable GPIO
CONFIG_GPIO=y

# Enable pin control (see https://docs.zephyrproject.org/latest/hardware/pinctrl/index.html)
CONFIG_PINCTRL=y
