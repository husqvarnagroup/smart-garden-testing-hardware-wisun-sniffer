if BOARD_SI4467_DONGLE

source "boards/common/usb/Kconfig.cdc_acm_serial.defconfig"

if CDC_ACM_SERIAL_INITIALIZE_AT_BOOT

# We use the Nordic Semiconductor vendor ID for USB. This is semi-officially OK for small series /
# internal products:
# - https://devzone.nordicsemi.com/f/nordic-q-a/33851/nrf52840---usb-vendor-id-and-usb-product-id
# - https://devzone.nordicsemi.com/f/nordic-q-a/50638/usb-pid-for-nrf52840
#
# The product ID is randomly chosen in an area where Nordic does not seem to have any products (see
# http://www.linux-usb.org/usb.ids).
#
# Note: vendor ID 0x2fe3 is also listed as Nordic Semiconductor; this is however owned by the Zephyr
# project and should not be used for own products:
# https://docs.zephyrproject.org/latest/connectivity/usb/device/usb_device.html#usb-vendor-and-product-identifiers
config CDC_ACM_SERIAL_VID
	default 0x1915

config CDC_ACM_SERIAL_PID
	default 0xB820

config CDC_ACM_SERIAL_MANUFACTURER_STRING
	default "Gardena"

config CDC_ACM_SERIAL_PRODUCT_STRING
	default "Si4467 Dongle"

endif # CDC_ACM_SERIAL_INITIALIZE_AT_BOOT

if LOG

# The log goes out over the USB device this driver runs; Zephyr's common defaults above silence the
# stack and the CDC ACM class for the same reason.
choice UDC_DRIVER_LOG_LEVEL_CHOICE
	default UDC_DRIVER_LOG_LEVEL_OFF
endchoice

endif # LOG

endif # BOARD_SI4467_DONGLE
