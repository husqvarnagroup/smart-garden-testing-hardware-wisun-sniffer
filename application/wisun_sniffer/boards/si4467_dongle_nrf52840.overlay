/ {
	chosen {
		/*
		 * Console, log and shell stay on cdc_acm_uart0 (the board default), so the first
		 * USB interface keeps behaving like every other dongle application. The capture
		 * stream gets its own interface, because it carries binary PCAP-NG data that must
		 * not be interleaved with text.
		 */
		zephyr,sniffer-uart = &cdc_acm_uart1;
	};
};

&usbd {
	cdc_acm_uart1: cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
		/*
		 * A Wi-SUN PSDU may be up to 2047 octets. Four times the largest frame rather
		 * than twice it, because this buffer sits behind the application's own staging
		 * buffer and a frame that reaches it has already been counted as captured --
		 * losing it here would not show up in the drop counter.
		 */
		tx-fifo-size = <8192>;
	};
};
